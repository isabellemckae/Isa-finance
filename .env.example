# ISA Finance environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in your hosting provider's encrypted settings
# (Vercel → Project → Settings → Environment Variables, marked "Sensitive").

# --- Modes --------------------------------------------------------------------
# demo     = local only, no sign-in, fictional data. Refused when NODE_ENV=production.
# supabase = real Supabase Auth (default in production).
AUTH_MODE=demo
# demo     = fictional dataset (edits kept in memory only).
# supabase = your own data in Supabase, protected by Row Level Security.
#            Requires AUTH_MODE=supabase.
DATA_SOURCE=demo

# --- Supabase (required when AUTH_MODE=supabase) ------------------------------
# Project Settings → API. The publishable (or legacy anon) key is designed to be
# public; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The one email address allowed to use this private app.
ALLOWED_USER_EMAIL=
# Require TOTP two-factor authentication (strongly recommended: keep true).
REQUIRE_MFA=true
# Secret / service-role key. Bypasses RLS. Server-only. Not needed until Phase 4.
SUPABASE_SECRET_KEY=

# --- OpenAI: Personal CFO (Phase 3) -------------------------------------------
# Optional. Without a key the CFO still answers common questions with calculated
# (non-AI) answers. Create a project-scoped key at platform.openai.com with a
# monthly budget cap. Server-only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Model id for the Responses API. Blank uses the default in src/lib/cfo/openai-model.ts.
OPENAI_MODEL=
# Per-day caps (UTC). Blank uses the defaults (150 requests, 400000 tokens).
CFO_DAILY_REQUEST_LIMIT=
CFO_DAILY_TOKEN_LIMIT=

# --- Plaid (Phase 4, sandbox only) --------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# Only "sandbox" is accepted until the Phase 5 security review.
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# --- Plaid token encryption keyring (Phase 4) ---------------------------------
# Comma-separated "keyId:base64(32 random bytes)" entries, newest first.
# Generate locally:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep an offline backup. See docs/SECURITY.md for rotation and recovery.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
